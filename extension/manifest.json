{
  "manifest_version": 3,
  "name": "Local Connection Queue",
  "version": "0.2.7",
  "description": "A local connection queue using the LinkedIn session in your existing browser.",
  "permissions": ["storage", "scripting"],
  "host_permissions": ["https://*.linkedin.com/*", "https://linkedin.com/*"],
  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"]
  },
  "action": {"default_title": "Open connection queue"},
  "options_ui": {"page": "web/index.html", "open_in_tab": true},
  "browser_specific_settings": {
    "gecko": {
      "id": "connection-queue@local.invalid",
      "strict_min_version": "121.0",
      "data_collection_permissions": {"required": ["none"]}
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'"
  }
}
